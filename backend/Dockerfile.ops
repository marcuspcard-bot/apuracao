FROM postgres:17-bookworm AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv restic ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/venv \
    && useradd --create-home --uid 10001 backupuser
ENV PATH="/opt/venv/bin:$PATH" PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 RESTIC_CACHE_DIR=/tmp/restic-cache
WORKDIR /app
COPY requirements.lock .
RUN pip install --no-cache-dir -c requirements.lock httpx 'psycopg[binary]'
COPY ops ./ops
USER backupuser
ENTRYPOINT ["python", "-m", "ops"]

FROM runtime AS test
USER root
RUN pip install --no-cache-dir -c requirements.lock pytest
USER backupuser
ENTRYPOINT ["python", "-m", "pytest", "ops/tests", "-q"]
