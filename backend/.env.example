DATABASE_URL=postgresql+psycopg://apuracao:apuracao@localhost:55432/apuracao
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=boletins
FRONTEND_URL=http://localhost:5173
MAX_PDF_SIZE_MB=10
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Same key on every backend instance. Never expose it in VITE_* variables.
PREVIEW_SECRET_KEY=
PREVIEW_TTL_SECONDS=900
# Per backend process. With multiple replicas, add their connection/worker budgets.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_CONNECT_TIMEOUT_SECONDS=10
DB_LOCK_TIMEOUT_MS=10000
PDF_WORKERS=2
PDF_MAX_PENDING=10
PDF_TIMEOUT_SECONDS=30
# Bound entire requests, not only PDF parsing. Leave DB connections for read-only pages.
IMPORT_MAX_CONCURRENT=5
REQUEST_BODY_TIMEOUT_SECONDS=120
STORAGE_MAX_CONNECTIONS=10
STORAGE_TIMEOUT_SECONDS=45
TELAO_REALTIME_ENABLED=true

# Supabase Auth user UUIDs allowed to administer the application. Fail closed if empty.
ADMIN_USER_IDS=
