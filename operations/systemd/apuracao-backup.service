[Unit]
Description=Backup criptografado da apuracao
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=20min
ExecStart=/usr/bin/docker run --rm --init --name apuracao-backup-job --env-file /etc/apuracao-operations.env apuracao-ops:local backup
ExecStopPost=-/usr/bin/docker rm --force apuracao-backup-job
