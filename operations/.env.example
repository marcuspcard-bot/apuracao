# Private environment for the backup/monitor jobs. Never expose these in VITE_*.
# Prefer a read-only DB role, direct connection or session pooler, and TLS.
BACKUP_DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=boletins
# A separate PRIVATE S3-compatible bucket/account. Restic encrypts all contents.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
PUBLIC_API_URL=
BACKUP_MAX_AGE_HOURS=3
# Optional HTTPS webhook receiving {"text": "..."}; never contains PDFs or keys.
OPS_ALERT_WEBHOOK_URL=
